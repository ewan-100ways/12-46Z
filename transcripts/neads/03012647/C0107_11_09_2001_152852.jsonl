{"start": 251.6, "end": 253.96, "text": "Are you in contact with Steel 7-2?", "p": -0.25451389302810035, "nospeech": 0.67138671875, "words": [[251.6, 252.0, " Are", 0.97], [252.0, 252.22, " you", 1.0], [252.22, 252.36, " in", 1.0], [252.36, 252.66, " contact", 1.0], [252.66, 252.96, " with", 1.0], [252.96, 253.22, " Steel", 0.81], [253.22, 253.54, " 7", 0.72], [253.54, 253.96, "-2?", 0.98]]}
