{"start": 387.33, "end": 389.43, "text": "I see a guy squawking 1,200.", "p": -0.19513081031483273, "nospeech": 0.4482421875, "words": [[387.33, 387.73, " I", 0.99], [387.73, 388.01, " see", 1.0], [388.01, 388.07, " a", 0.98], [388.07, 388.55, " guy", 1.0], [388.55, 389.01, " squawking", 0.99], [389.01, 389.13, " 1", 1.0], [389.13, 389.43, ",200.", 1.0]]}
{"start": 389.69, "end": 390.23, "text": "Yeah, that's me.", "p": -0.19513081031483273, "nospeech": 0.4482421875, "words": [[389.69, 390.01, " Yeah,", 0.7], [390.03, 390.21, " that's", 1.0], [390.21, 390.23, " me.", 0.63]]}
{"start": 390.23, "end": 391.81, "text": "He wasn't 7,500 feet.", "p": -0.19513081031483273, "nospeech": 0.4482421875, "words": [[390.23, 390.41, " He", 0.91], [390.41, 390.59, " wasn't", 0.89], [390.59, 390.87, " 7", 0.99], [390.87, 391.41, ",500", 1.0], [391.41, 391.81, " feet.", 1.0]]}
{"start": 392.27, "end": 392.79, "text": "Yep, that's him.", "p": -0.11026152587951497, "nospeech": 0.07763671875, "words": [[392.27, 392.41, " Yep,", 0.53], [392.43, 392.63, " that's", 1.0], [392.63, 392.79, " him.", 1.0]]}
