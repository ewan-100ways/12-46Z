{"start": 402.33, "end": 404.97, "text": "We have tried, but we haven't had any success.", "p": -0.11026152587951497, "nospeech": 0.07763671875, "words": [[402.33, 402.59, " We", 1.0], [402.59, 402.81, " have", 1.0], [402.81, 403.39, " tried,", 1.0], [403.65, 403.89, " but", 1.0], [403.89, 404.09, " we", 1.0], [404.09, 404.35, " haven't", 1.0], [404.35, 404.43, " had", 1.0], [404.43, 404.63, " any", 1.0], [404.63, 404.97, " success.", 1.0]]}
{"start": 405.33, "end": 406.23, "text": "Okay, no problem.", "p": -0.11026152587951497, "nospeech": 0.07763671875, "words": [[405.33, 405.61, " Okay,", 1.0], [405.71, 405.93, " no", 1.0], [405.93, 406.23, " problem.", 1.0]]}
