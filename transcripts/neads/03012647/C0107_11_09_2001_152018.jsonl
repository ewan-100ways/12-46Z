{"start": 395.33, "end": 397.69, "text": "We were told the tower had a visual on him.", "p": -0.11026152587951497, "nospeech": 0.07763671875, "words": [[395.33, 395.43, " We", 0.99], [395.43, 395.51, " were", 1.0], [395.51, 395.79, " told", 1.0], [395.79, 396.07, " the", 1.0], [396.07, 396.81, " tower", 0.99], [396.81, 397.05, " had", 1.0], [397.05, 397.17, " a", 1.0], [397.17, 397.39, " visual", 0.85], [397.39, 397.59, " on", 1.0], [397.59, 397.69, " him.", 1.0]]}
{"start": 397.75, "end": 399.79, "text": "They said that he was some sort of Malibu or some sort.", "p": -0.11026152587951497, "nospeech": 0.07763671875, "words": [[397.75, 397.79, " They", 1.0], [397.79, 397.99, " said", 1.0], [397.99, 398.11, " that", 0.9], [398.11, 398.25, " he", 0.99], [398.25, 398.35, " was", 1.0], [398.35, 398.51, " some", 1.0], [398.51, 398.67, " sort", 1.0], [398.67, 398.81, " of", 1.0], [398.81, 399.31, " Malibu", 0.99], [399.31, 399.35, " or", 1.0], [399.35, 399.55, " some", 1.0], [399.55, 399.79, " sort.", 1.0]]}
{"start": 399.95, "end": 400.71, "text": "Okay, it is a Malibu.", "p": -0.11026152587951497, "nospeech": 0.07763671875, "words": [[399.95, 400.23, " Okay,", 1.0], [400.33, 400.35, " it", 0.9], [400.35, 400.43, " is", 0.88], [400.43, 400.49, " a", 0.98], [400.49, 400.71, " Malibu.", 1.0]]}
