{"start": 3.06, "end": 4.64, "text": "What side are you from? Do you want me to help you?", "p": -0.19681677314805687, "nospeech": 0.85107421875, "words": [[3.06, 3.44, " What", 0.08], [3.44, 3.78, " side", 0.59], [3.78, 3.94, " are", 0.9], [3.94, 3.96, " you", 0.99], [3.96, 4.1, " from?", 0.05], [4.22, 4.32, " Do", 0.72], [4.32, 4.32, " you", 0.88], [4.32, 4.38, " want", 0.92], [4.38, 4.4, " me", 0.98], [4.4, 4.42, " to", 0.99], [4.42, 4.52, " help", 1.0], [4.52, 4.64, " you?", 1.0]]}
