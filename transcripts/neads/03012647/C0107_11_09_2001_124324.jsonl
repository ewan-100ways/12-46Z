{"start": 9.24, "end": 11.22, "text": "A second aircraft hitting the Trade Center?", "p": -0.19681677314805687, "nospeech": 0.85107421875, "words": [[9.24, 9.62, " A", 0.99], [9.62, 9.88, " second", 1.0], [9.88, 10.18, " aircraft", 1.0], [10.18, 10.52, " hitting", 1.0], [10.52, 10.74, " the", 1.0], [10.74, 10.96, " Trade", 1.0], [10.96, 11.22, " Center?", 1.0]]}
