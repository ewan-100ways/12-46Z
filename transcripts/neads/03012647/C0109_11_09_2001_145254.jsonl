{"start": 203.32, "end": 203.6, "text": "Yes.", "p": -0.21794458547818293, "nospeech": 0.162109375, "words": [[203.32, 203.6, " Yes.", 0.62]]}
{"start": 203.64, "end": 205.16, "text": "There's somebody on the phone who wants to talk to you.", "p": -0.21794458547818293, "nospeech": 0.162109375, "words": [[203.64, 203.78, " There's", 0.52], [203.78, 203.9, " somebody", 1.0], [203.9, 204.06, " on", 1.0], [204.06, 204.14, " the", 1.0], [204.14, 204.34, " phone", 1.0], [204.34, 204.44, " who", 0.47], [204.44, 204.58, " wants", 1.0], [204.58, 204.68, " to", 1.0], [204.68, 204.84, " talk", 1.0], [204.84, 205.0, " to", 1.0], [205.0, 205.16, " you.", 1.0]]}
{"start": 205.92, "end": 206.64, "text": "Can you hear us?", "p": -0.21794458547818293, "nospeech": 0.162109375, "words": [[205.92, 206.24, " Can", 1.0], [206.24, 206.32, " you", 0.69], [206.32, 206.48, " hear", 1.0], [206.48, 206.64, " us?", 1.0]]}
