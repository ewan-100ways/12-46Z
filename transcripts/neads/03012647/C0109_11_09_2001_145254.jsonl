{"start": 208.56, "end": 209.78, "text": "Lieutenant Colonel Knapp on secure line.", "p": -0.21794458547818293, "nospeech": 0.162109375, "words": [[208.56, 208.78, " Lieutenant", 0.99], [208.78, 209.04, " Colonel", 1.0], [209.04, 209.26, " Knapp", 0.89], [209.26, 209.4, " on", 0.94], [209.4, 209.58, " secure", 0.97], [209.58, 209.78, " line.", 1.0]]}
{"start": 209.78, "end": 211.88, "text": "Hey, sir, this is Lieutenant Miner from Huntress.", "p": -0.20526316048283327, "nospeech": 0.41015625, "words": [[209.78, 210.14, " Hey,", 0.31], [210.28, 210.32, " sir,", 0.95], [210.44, 210.56, " this", 1.0], [210.56, 210.68, " is", 1.0], [210.68, 211.02, " Lieutenant", 0.58], [211.02, 211.44, " Miner", 0.64], [211.44, 211.54, " from", 0.99], [211.54, 211.88, " Huntress.", 0.98]]}
