{"start": 85.72, "end": 87.4, "text": "Are you telling him out to us?", "p": -0.24682971122472183, "nospeech": 0.3447265625, "words": [[85.72, 86.2, " Are", 0.83], [86.2, 86.36, " you", 1.0], [86.36, 86.62, " telling", 1.0], [86.62, 86.82, " him", 1.0], [86.82, 87.0, " out", 1.0], [87.0, 87.16, " to", 1.0], [87.16, 87.4, " us?", 1.0]]}
