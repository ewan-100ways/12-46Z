{"start": 52.62, "end": 54.83, "text": "And that's affirmative.", "p": -0.27093161530089827, "nospeech": 0.2037353515625, "words": [[52.62, 53.1, " And", 0.95], [54.25, 54.61, " that's", 1.0], [54.61, 54.83, " affirmative.", 1.0]]}
