{"start": 8.61, "end": 9.45, "text": "I wasn't sure.", "p": -0.2090212328113475, "nospeech": 0.7421875, "words": [[8.61, 8.93, " I", 0.94], [8.93, 9.25, " wasn't", 1.0], [9.25, 9.45, " sure.", 1.0]]}
