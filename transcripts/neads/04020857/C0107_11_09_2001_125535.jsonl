{"start": 2.53, "end": 3.93, "text": "Yes, Sergeant Zubon, how are you doing?", "p": -0.2090212328113475, "nospeech": 0.7421875, "words": [[2.53, 2.85, " Yes,", 0.8], [2.85, 3.25, " Sergeant", 0.87], [3.25, 3.53, " Zubon,", 0.91], [3.59, 3.71, " how", 1.0], [3.71, 3.75, " are", 0.39], [3.75, 3.77, " you", 1.0], [3.77, 3.93, " doing?", 1.0]]}
{"start": 4.13, "end": 4.65, "text": "Not too bad, Joe.", "p": -0.2090212328113475, "nospeech": 0.7421875, "words": [[4.13, 4.27, " Not", 0.99], [4.27, 4.37, " too", 1.0], [4.37, 4.51, " bad,", 1.0], [4.57, 4.65, " Joe.", 0.98]]}
