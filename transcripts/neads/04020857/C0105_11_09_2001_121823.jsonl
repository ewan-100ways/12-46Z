{"start": 64.1, "end": 66.54, "text": "He took off out of Boston, originally heading for...", "p": -0.16076389617390102, "nospeech": 0.66650390625, "words": [[64.1, 64.5, " He", 0.66], [64.5, 64.64, " took", 0.99], [64.64, 64.84, " off", 0.99], [64.84, 64.98, " out", 0.97], [64.98, 65.06, " of", 1.0], [65.06, 65.38, " Boston,", 1.0], [65.48, 65.7, " originally", 0.96], [65.7, 66.06, " heading", 0.99], [66.06, 66.54, " for...", 0.75]]}
