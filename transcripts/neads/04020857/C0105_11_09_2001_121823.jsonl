{"start": 75.35, "end": 78.19, "text": "He's heading towards Kennedy. It looks like the speed is decreasing.", "p": -0.16076389617390102, "nospeech": 0.66650390625, "words": [[75.35, 75.75, " He's", 0.67], [75.75, 75.93, " heading", 0.95], [75.93, 76.11, " towards", 0.96], [76.11, 76.47, " Kennedy.", 1.0], [76.79, 76.99, " It", 0.84], [76.99, 77.19, " looks", 1.0], [77.19, 77.33, " like", 1.0], [77.33, 77.45, " the", 0.99], [77.45, 77.71, " speed", 1.0], [77.71, 77.85, " is", 1.0], [77.85, 78.19, " decreasing.", 1.0]]}
