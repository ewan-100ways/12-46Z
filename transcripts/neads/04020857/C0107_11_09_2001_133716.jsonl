{"start": 177.9, "end": 179.62, "text": "Cleveland talked to them. They talked to the pilot.", "p": -0.2984467328652828, "nospeech": 0.265869140625, "words": [[177.9, 178.26, " Cleveland", 0.21], [178.26, 178.54, " talked", 0.92], [178.54, 178.76, " to", 1.0], [178.76, 178.94, " them.", 1.0], [178.94, 179.06, " They", 1.0], [179.06, 179.22, " talked", 1.0], [179.22, 179.3, " to", 1.0], [179.3, 179.38, " the", 1.0], [179.38, 179.62, " pilot.", 1.0]]}
{"start": 179.7, "end": 181.32, "text": "He's not declaring emergency, but they're going ahead.", "p": -0.2984467328652828, "nospeech": 0.265869140625, "words": [[179.7, 179.86, " He's", 1.0], [179.86, 179.96, " not", 1.0], [179.96, 180.26, " declaring", 1.0], [180.26, 180.5, " emergency,", 0.93], [180.7, 180.82, " but", 1.0], [180.82, 180.94, " they're", 1.0], [180.94, 181.08, " going", 1.0], [181.08, 181.32, " ahead.", 0.99]]}
{"start": 181.52, "end": 182.58, "text": "I mean, hijacked.", "p": -0.2984467328652828, "nospeech": 0.265869140625, "words": [[181.52, 181.76, " I", 0.99], [181.76, 181.94, " mean,", 1.0], [181.94, 182.58, " hijacked.", 0.91]]}
{"start": 182.58, "end": 185.0, "text": "They're going to go ahead and land him at Cleveland for precautionary measures.", "p": -0.2984467328652828, "nospeech": 0.265869140625, "words": [[182.58, 182.76, " They're", 1.0], [182.76, 182.86, " going", 1.0], [182.86, 182.92, " to", 0.68], [182.92, 183.0, " go", 0.67], [183.0, 183.1, " ahead", 1.0], [183.1, 183.3, " and", 1.0], [183.3, 183.5, " land", 1.0], [183.5, 183.64, " him", 0.81], [183.64, 183.72, " at", 1.0], [183.72, 184.02, " Cleveland", 0.99], [184.02, 184.3, " for", 1.0], [184.3, 184.74, " precautionary", 0.78], [184.74, 185.0, " measures.", 1.0]]}
