{"start": 12.94, "end": 14.0, "text": "But I've got a question.", "p": -0.248617260856966, "nospeech": 0.103271484375, "words": [[12.94, 13.12, " But", 0.93], [13.12, 13.36, " I've", 0.97], [13.36, 13.7, " got", 1.0], [13.7, 13.78, " a", 1.0], [13.78, 14.0, " question.", 1.0]]}
